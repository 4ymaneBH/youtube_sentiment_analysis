{
  "manifest_version": 3,
  "name": "YouTube Sentiment",
  "version": "1.1.0",
  "description": "Analyze the sentiment of comments loaded on a YouTube video.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Spectrum for YouTube",
    "default_icon": {
      "16": "icons/spectrum-16.png",
      "32": "icons/spectrum-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/spectrum-16.png",
    "32": "icons/spectrum-32.png",
    "48": "icons/spectrum-48.png",
    "128": "icons/spectrum-128.png"
  }
}
