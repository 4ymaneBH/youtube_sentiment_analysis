{
  "name": "Spectrum Sentiment API",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "containerEnv": {
    "OPENBLAS_NUM_THREADS": "2",
    "OMP_NUM_THREADS": "2"
  },
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": { "label": "Spectrum API" }
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install --require-hashes -r requirements.txt",
  "postStartCommand": "nohup .venv/bin/python -m uvicorn app_api:app --app-dir src --host 0.0.0.0 --port 7860 </dev/null >/tmp/spectrum-api.log 2>&1 &",
  "waitFor": "postCreateCommand"
}
